// Database schema for the corporate website template.
// Localized text is stored as JSON objects: { "ar": "...", "en": "..." }.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ───────────── Users, sessions & audit ─────────────
 */

enum Role {
  ADMIN // مدير رئيسي
  EDITOR // محرر محتوى
  VIEWER // قراءة ومتابعة
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(VIEWER)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
}

/// Session id is the SHA-256 of the random token kept in the cookie, so a DB leak can't be replayed.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/**
 * ───────────── Site configuration ─────────────
 */

/// Singleton documents: "site" (identity, contact, navigation, footer), "home", "about".
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Free-form pages (legal pages and any custom page created from the admin panel).
model Page {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          Json
  body           Json
  status         PageStatus @default(PUBLISHED)
  seoDescription Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/**
 * ───────────── Content ─────────────
 */

model ServiceCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     Json
  order    Int       @default(0)
  services Service[]
}

model Service {
  id         String          @id @default(cuid())
  slug       String          @unique
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  icon       String
  title      Json
  summary    Json
  body       Json
  features   Json            @default("[]")
  gallery    String[]
  image      String
  featured   Boolean         @default(false)
  published  Boolean         @default(true)
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Sector {
  id         String         @id @default(cuid())
  slug       String         @unique
  icon       String
  name       Json
  summary    Json
  body       Json
  challenges Json           @default("[]")
  order      Int            @default(0)
  published  Boolean        @default(true)
  projects   Project[]
  stories    SuccessStory[]
}

enum ProjectStatus {
  COMPLETED
  ONGOING
}

model Project {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     Json
  summary   Json
  body      Json
  client    Json
  scope     Json          @default("[]")
  gallery   String[]
  sectorId  String?
  sector    Sector?       @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  status    ProjectStatus @default(COMPLETED)
  location  Json
  year      Int
  image     String
  featured  Boolean       @default(false)
  published Boolean       @default(true)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum NewsKind {
  NEWS
  ARTICLE
  ANNOUNCEMENT
  EVENT
}

model NewsPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  kind          NewsKind  @default(NEWS)
  title         Json
  excerpt       Json
  body          Json
  image         String
  publishedAt   DateTime
  eventDate     DateTime?
  eventLocation Json?
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([publishedAt])
}

model Client {
  id        String  @id @default(cuid())
  name      Json
  logo      String
  url       String?
  order     Int     @default(0)
  published Boolean @default(true)
}

model Testimonial {
  id        String  @id @default(cuid())
  quote     Json
  author    Json
  role      Json
  rating    Int     @default(5)
  order     Int     @default(0)
  published Boolean @default(true)
}

model SuccessStory {
  id          String  @id @default(cuid())
  title       Json
  sectorId    String?
  sector      Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  challenge   Json
  solution    Json
  result      Json
  metricValue String
  metricLabel Json
  order       Int     @default(0)
  published   Boolean @default(true)
}

model GalleryPhoto {
  id      String @id @default(cuid())
  src     String
  caption Json
  album   Json
  order   Int    @default(0)
}

model Video {
  id        String  @id @default(cuid())
  title     Json
  poster    String
  youtubeId String?
  duration  String
  order     Int     @default(0)
}

model Branch {
  id           String  @id @default(cuid())
  name         Json
  address      Json
  phone        String
  phoneDisplay String
  email        String
  hours        Json
  lat          Float
  lng          Float
  isMain       Boolean @default(false)
  order        Int     @default(0)
}

model Faq {
  id       String @id @default(cuid())
  category Json
  question Json
  answer   Json
  order    Int    @default(0)
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model Job {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            Json
  department       Json
  location         Json
  type             JobType          @default(FULL_TIME)
  experience       Json
  summary          Json
  responsibilities Json             @default("[]")
  requirements     Json             @default("[]")
  open             Boolean          @default(true)
  postedAt         DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  applications     JobApplication[]
}

/**
 * ───────────── Inbox (wired up in phase 6) ─────────────
 */

/// Uploaded file metadata; the bytes live in the configured storage (local disk or S3-compatible).
model StoredFile {
  id           String           @id @default(cuid())
  key          String           @unique
  originalName String
  kind         String
  size         Int
  private      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  quotes       QuoteRequest[]
  applications JobApplication[]
}

enum InboxStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String      @id @default(cuid())
  name      String
  phone     String
  email     String
  message   String
  status    InboxStatus @default(NEW)
  ip        String?
  createdAt DateTime    @default(now())

  @@index([status, createdAt])
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  QUOTED
  WON
  LOST
  CLOSED
}

model QuoteRequest {
  id           String      @id @default(cuid())
  reference    String      @unique
  name         String
  company      String?
  phone        String
  email        String
  serviceSlug  String
  details      String
  attachmentId String?
  attachment   StoredFile? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  status       QuoteStatus @default(NEW)
  notes        String?
  ip           String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, createdAt])
}

enum ApplicationStatus {
  NEW
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

model JobApplication {
  id          String            @id @default(cuid())
  reference   String            @unique
  jobId       String?
  job         Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  name        String
  phone       String
  email       String
  city        String?
  experience  String?
  linkedin    String?
  coverLetter String?
  cvId        String?
  cv          StoredFile?       @relation(fields: [cvId], references: [id], onDelete: SetNull)
  status      ApplicationStatus @default(NEW)
  notes       String?
  ip          String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt])
}
