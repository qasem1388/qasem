<%- include('../partials/head') %>
<%- include('../partials/page-hero', { heroTitle: t('projects') }) %>
<section class="section">
  <div class="container">
    <% if (categories.length > 1) { %>
      <div class="chips"><a class="chip<%= !category ? ' is-active' : '' %>" href="/projects"><%= t('all') %></a><% categories.forEach(function (c) { %><a class="chip<%= category === c ? ' is-active' : '' %>" href="?category=<%= encodeURIComponent(c) %>"><%= c %></a><% }) %></div>
    <% } %>
    <% if (projects.length) { %>
    <div class="grid grid--3">
      <% projects.forEach(function (p) { %>
        <article class="card">
          <a class="card__media" href="/projects/<%= encodeURIComponent(p.slug) %>" tabindex="-1" aria-hidden="true"><% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy"><% } else { %><span class="card__placeholder"><i class="fa-solid fa-diagram-project"></i></span><% } %></a>
          <div class="card__body">
            <% if (p.category) { %><div class="meta"><span class="tag"><%= p.category %></span></div><% } %>
            <h2 class="card__title"><a href="/projects/<%= encodeURIComponent(p.slug) %>"><%= p.title %></a></h2>
            <p class="card__text"><%= p.summary %></p>
            <a class="link-more" href="/projects/<%= encodeURIComponent(p.slug) %>"><%= t('details') %> <i class="fa-solid fa-arrow-left"></i></a>
          </div>
        </article>
      <% }) %>
    </div>
    <% } else { %><p class="empty"><%= t('no_results') %></p><% } %>
  </div>
</section>
<%- include('../partials/footer') %>
