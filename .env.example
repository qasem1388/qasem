# كلمة مرور المدير عند التشغيل الأول (اسم المستخدم: admin)
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# عنوان التطبيق على الإنترنت، يُستخدم في روابط المشاركة عبر واتساب
PUBLIC_URL=https://archive.example.com

# مفتاح سري طويل لتوقيع جلسات الدخول (أي نص عشوائي طويل)
JWT_SECRET=

# Google Drive: عند وضع هذه القيم تُحفظ الملفات في Drive تلقائياً
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# اسم المجلد في Drive (يُنشأ تلقائياً)
DRIVE_FOLDER_NAME=أرشيف الموظفين

# أقصى حجم للملف الواحد بالميغابايت (0 = بدون حد)
MAX_UPLOAD_MB=0
PORT=3000
NODE_ENV=production

# أين تُحفظ النسخ الاحتياطية اليومية (يُفضّل قرص آخر غير قرص البيانات)
BACKUP_DIR=
BACKUP_HOUR=2

# قراءة النص من الصور (1 = مفعّلة، 0 = موقوفة)
OCR=1

# البحث في كلام الفيديو والصوت: خدمة تفريغ متوافقة مع OpenAI، مثل Groq
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3

# اقتراح التصنيف والوسوم بالذكاء الاصطناعي (Claude)
ANTHROPIC_API_KEY=
AI_AUTO_TAG=1
