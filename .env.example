# ─────────────────────────────────────────────────────────────
# انسخ هذا الملف إلى .env ثم عدّل القيم. لا ترفع .env إلى Git أبدًا.
# ─────────────────────────────────────────────────────────────

# الرابط العام للموقع بدون / في النهاية (canonical، خريطة الموقع، Open Graph، روابط البريد)
# يُقرأ وقت التشغيل، فيمكن تغييره دون إعادة البناء.
SITE_URL=http://localhost:3000

# اتصال قاعدة بيانات PostgreSQL — استخدم مستخدمًا مخصصًا بكلمة مرور قوية
# (رمّز الأحرف الخاصة في كلمة المرور بصيغة URL مثل %40 بدل @)
DATABASE_URL="postgresql://riyada:CHANGE_ME@localhost:5432/riyada?schema=public"

# عدد الوكلاء العكسيين (Nginx / موازن أحمال / Cloudflare) أمام التطبيق.
# يُستخدم لاستخراج IP الزائر الحقيقي من X-Forwarded-For لتحديد المعدل وسجل العمليات.
# 1 = خلف Nginx واحد (الإعداد الشائع). 2 = Cloudflare ثم Nginx. 0 = لا يوجد وكيل.
TRUSTED_PROXY_HOPS=1

# مجلد حفظ الملفات المرفوعة (مشغل التخزين المحلي). احرص على نسخه احتياطيًا.
STORAGE_DIR=./storage

# خادم البريد لإرسال إشعارات النماذج ورسائل التأكيد (اختياري).
# بدونه تُحفظ الطلبات في لوحة التحكم بشكل طبيعي دون إرسال بريد.
# المنفذ 587 مع STARTTLS (SMTP_SECURE=false) أو 465 مع TLS مباشر (SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="اسم الشركة <no-reply@your-domain.sa>"

# ── Docker Compose فقط ───────────────────────────────────────
# بيانات قاعدة البيانات التي ينشئها حاوي PostgreSQL. في Docker يُبنى DATABASE_URL
# تلقائيًا من هذه القيم (لا حاجة لتعديل DATABASE_URL أعلاه).
POSTGRES_DB=riyada
POSTGRES_USER=riyada
# أنشئ كلمة مرور قوية: openssl rand -hex 24
POSTGRES_PASSWORD=
# المنفذ المحلي الذي يستمع عليه الموقع خلف Nginx
APP_PORT=3000

# ── خيارات متقدمة (اتركها فارغة إن لم تحتجها) ─────────────────
# 1 = عدم توليد الصفحات أثناء البناء (تُبنى مع أول زيارة). مفعّل تلقائيًا في Docker.
# SKIP_PRERENDER=1
# عند تشغيل أكثر من نسخة من التطبيق خلف موازن أحمال: مفتاح ثابت مشترك (openssl rand -base64 32)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
