# ===== إعدادات عامة =====
NODE_ENV=development
PORT=3000
# رابط الموقع النهائي (يُستخدم في Canonical و Sitemap و Open Graph)
SITE_URL=

# ===== الأمان (إلزامي في الإنتاج) =====
# مفتاح عشوائي طويل لتوقيع الجلسات. لتوليده: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=8

# ===== قاعدة البيانات =====
# اتركه فارغًا لاستخدام SQLite محليًا، أو ضع رابط PostgreSQL (موصى به على Replit والإنتاج)
DATABASE_URL=
DATABASE_SSL=false
SQLITE_FILE=data/database.sqlite

# ===== حساب المدير الأول (يُنشأ مرة واحدة عند أول تشغيل فقط) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=مدير النظام

# تعبئة بيانات تجريبية عند أول تشغيل
SEED_DEMO=true

# ===== الملفات =====
UPLOAD_DIR=uploads
PRIVATE_STORAGE_DIR=storage/private
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=20
BACKUP_DIR=backups
