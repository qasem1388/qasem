# الرابط العام للموقع (يُستخدم في روابط canonical وخريطة الموقع وOpen Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# اتصال قاعدة بيانات PostgreSQL — استخدم مستخدمًا مخصصًا بكلمة مرور قوية
# (رمّز الأحرف الخاصة في كلمة المرور بصيغة URL مثل %40 بدل @)
DATABASE_URL="postgresql://riyada:CHANGE_ME@localhost:5432/riyada?schema=public"

# مجلد حفظ الملفات المرفوعة (مشغل التخزين المحلي). احرص على نسخه احتياطيًا.
STORAGE_DIR=./storage
